# Defaults for every environment. Real secrets go in .env.local (dev) or Secret Manager (prod), never here.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

GOOGLE_CLOUD_PROJECT=flamants-bleus-dev
TRUSTED_PROXIES=127.0.0.1

# OAuth client from the Google Cloud console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seeds the member list on this person's first login.
ADMIN_BOOTSTRAP_EMAIL=

LOGO_BASE_URL=/uploads
LOGO_BUCKET=

INSTAGRAM_URL=https://www.instagram.com/cieflamantsbleus/
FACEBOOK_URL=https://www.facebook.com/LesFlamantsBleus/
