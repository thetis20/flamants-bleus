{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="field{% if errors|length %} has-error{% endif %}">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="field-errors">
            {% for error in errors %}<li>{{ error.message }}</li>{% endfor %}
        </ul>
    {% endif %}
{% endblock %}
