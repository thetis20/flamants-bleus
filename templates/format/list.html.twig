{% extends 'base.html.twig' %}

{% block title %}Nos formats — Les Flamants Bleus{% endblock %}
{% block description %}Les spectacles d'improvisation théâtrale des Flamants Bleus : découvrez nos formats et leurs prochaines dates.{% endblock %}

{% block main %}
    <h1 class="page-title">Nos formats</h1>
    <div class="format-grid">
        {% for format in formats %}
            {{ include('_format_tile.html.twig', {format: format, heading: 'h2'}) }}
        {% else %}
            <p class="empty">Les formats arrivent bientôt.</p>
        {% endfor %}
    </div>
{% endblock %}
