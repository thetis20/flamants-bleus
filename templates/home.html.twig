{% extends 'base.html.twig' %}

{% block structured_data %}
    {% set same_as = [] %}
    {% for profile in [instagram_url, facebook_url] %}
        {% if profile %}{% set same_as = same_as|merge([profile]) %}{% endif %}
    {% endfor %}
    {% set troupe = {
        '@context': 'https://schema.org',
        '@type': 'PerformingGroup',
        name: 'Les Flamants Bleus',
        description: 'Troupe amateure d\'improvisation théâtrale',
        url: url('home'),
        logo: absolute_url(asset('images/logo.png')),
        email: contact_email,
        sameAs: same_as,
    } %}
    <script type="application/ld+json">{{ troupe|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block main %}
    <section class="hero">
        <p class="kicker">La troupe amateure d'improvisation théâtrale</p>
        <h1>Les Flamants Bleus</h1>
        <p class="tagline">L'imaginaire prend son envol</p>
    </section>

    <section class="agenda" aria-labelledby="agenda-title">
        <h2 id="agenda-title">Prochaines dates</h2>
        {% for row in rows %}
            {{ include('_event_card.html.twig', {event: row.event, format: row.format, venue: row.venue}) }}
        {% else %}
            <p class="empty">Pas de spectacle annoncé pour le moment. Suivez-nous sur les réseaux pour connaître les prochaines dates !</p>
        {% endfor %}
    </section>

    {% if formats %}
        <section class="formats" id="formats" aria-labelledby="formats-title">
            <h2 id="formats-title" class="page-title">Nos formats</h2>
            <div class="format-grid">
                {% for format in formats %}
                    {{ include('_format_tile.html.twig', {format: format, heading: 'h3'}) }}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if venues %}
        <section class="partners" id="lieux" aria-labelledby="partners-title">
            <h2 id="partners-title" class="page-title">Ils nous accueillent</h2>
            <div class="format-grid">
                {% for venue in venues %}
                    {{ include('_venue_tile.html.twig', {venue: venue}) }}
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
