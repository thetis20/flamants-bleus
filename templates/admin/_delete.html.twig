{# expects: action, token_id, confirm; optional: fields #}
<form method="post" action="{{ action }}" class="inline" onsubmit="return confirm({{ confirm|json_encode }})">
    <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
    {% for name, value in fields|default({}) %}
        <input type="hidden" name="{{ name }}" value="{{ value }}">
    {% endfor %}
    <button type="submit" class="link-danger">Supprimer</button>
</form>
