{% extends 'admin/base.html.twig' %}

{% macro rows(events, formats, venues, upcoming) %}
    <table class="table">
        <thead>
            <tr><th>Date</th><th>Titre</th><th>Format</th><th>Lieu</th><th>Prix</th><th>Réservation</th><th></th></tr>
        </thead>
        <tbody>
            {% for event in events %}
                <tr>
                    <td>{{ event.startsAt|format_datetime(pattern: 'EEE d MMM yyyy, HH:mm', locale: 'fr') }}</td>
                    <td><a href="{{ path('admin_event_edit', {id: event.id}) }}">{{ event.title }}</a></td>
                    <td>{{ formats[event.formatId].title ?? '—' }}</td>
                    <td>{{ venues[event.venueId].name ?? event.venue ?? '—' }}</td>
                    <td>{{ event.price ?: '—' }}</td>
                    <td>{% if event.bookingUrl %}<a href="{{ event.bookingUrl }}" target="_blank" rel="noopener">lien</a>{% elseif upcoming %}<a class="to-fill" href="{{ path('admin_event_edit', {id: event.id}) }}">à ajouter</a>{% else %}—{% endif %}</td>
                    <td class="actions">
                        <a href="{{ path('admin_event_edit', {id: event.id}) }}">Modifier</a>
                        <a href="{{ path('admin_event_duplicate', {id: event.id}) }}">Dupliquer</a>
                        {{ include('admin/_delete.html.twig', {
                            action: path('admin_event_delete', {id: event.id}),
                            token_id: 'delete-event-' ~ event.id,
                            confirm: 'Supprimer « ' ~ event.title ~ ' » ?',
                        }) }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{% block main %}
    <div class="toolbar">
        <h1>Dates</h1>
        <a class="button" href="{{ path('admin_event_new') }}">Ajouter une date</a>
    </div>

    <h2>À venir</h2>
    {% if upcoming %}
        {{ _self.rows(upcoming, formats, venues, true) }}
    {% else %}
        <p class="empty">Aucune date à venir.</p>
    {% endif %}

    {% if past %}
        <details>
            <summary>Dates passées ({{ past|length }} dernières)</summary>
            {{ _self.rows(past, formats, venues, false) }}
        </details>
    {% endif %}
{% endblock %}
