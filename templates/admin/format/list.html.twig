{% extends 'admin/base.html.twig' %}

{% block main %}
    <div class="toolbar">
        <h1>Formats</h1>
        <a class="button" href="{{ path('admin_format_new') }}">Ajouter un format</a>
    </div>

    {% if formats %}
        <table class="table">
            <thead><tr><th>Logo</th><th>Titre</th><th>Page</th><th></th></tr></thead>
            <tbody>
                {% for format in formats %}
                    <tr>
                        <td>{% if format.logoPath %}<img class="thumb" src="{{ logo_url(format.logoPath) }}" alt="">{% endif %}</td>
                        <td><a href="{{ path('admin_format_edit', {id: format.id}) }}">{{ format.title }}</a></td>
                        <td><a href="{{ path('format_show', {slug: format.slug}) }}" target="_blank">/formats/{{ format.slug }}</a></td>
                        <td class="actions">
                            <a href="{{ path('admin_format_edit', {id: format.id}) }}">Modifier</a>
                            {{ include('admin/_delete.html.twig', {
                                action: path('admin_format_delete', {id: format.id}),
                                token_id: 'delete-format-' ~ format.id,
                                confirm: 'Supprimer le format « ' ~ format.title ~ ' » ?',
                            }) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="empty">Aucun format pour l'instant.</p>
    {% endif %}
{% endblock %}
