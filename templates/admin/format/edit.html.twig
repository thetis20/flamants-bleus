{% extends 'admin/base.html.twig' %}

{% block main %}
    <h1>{{ heading }}</h1>
    {{ form_start(form, {attr: {class: 'form'}}) }}
        {{ form_row(form.title) }}
        {{ form_row(form.slug) }}
        {{ form_row(form.description) }}
        {% if format.logoPath %}
            <p class="current-logo"><img class="thumb" src="{{ logo_url(format.logoPath) }}" alt=""> Logo actuel — choisissez un fichier pour le remplacer.</p>
        {% endif %}
        {{ form_row(form.logoFile) }}
        {{ form_rest(form) }}
        <div class="form-actions">
            <button type="submit" class="button">Enregistrer</button>
            <a href="{{ cancel_url }}">Annuler</a>
        </div>
    {{ form_end(form) }}

    {% if is_edit %}
        <p class="danger-zone">
            {{ include('admin/_delete.html.twig', {
                action: path('admin_format_delete', {id: format.id}),
                token_id: 'delete-format-' ~ format.id,
                confirm: 'Supprimer le format « ' ~ format.title ~ ' » ?',
            }) }}
        </p>
    {% endif %}
{% endblock %}
