{% extends 'base.html.twig' %}

{% block title %}Espace membres — Les Flamants Bleus{% endblock %}
{% block body_class %}admin{% endblock %}

{% block body %}
    <header class="admin-header">
        <a href="{{ path('home') }}" class="brand-small" title="Voir le site">
            <img src="{{ asset('images/logo.webp') }}" alt="Les Flamants Bleus" width="64" height="56">
        </a>
        <nav class="admin-nav" aria-label="Administration">
            {% set section = app.current_route|split('_')[1] ?? '' %}
            <a href="{{ path('admin_events') }}"{% if section starts with 'event' %} aria-current="page"{% endif %}>Dates</a>
            <a href="{{ path('admin_formats') }}"{% if section starts with 'format' %} aria-current="page"{% endif %}>Formats</a>
            <a href="{{ path('admin_venues') }}"{% if section starts with 'venue' %} aria-current="page"{% endif %}>Lieux</a>
            <a href="{{ path('admin_links') }}"{% if section starts with 'link' %} aria-current="page"{% endif %}>Liens suivis</a>
            <a href="{{ path('admin_members') }}"{% if section starts with 'member' %} aria-current="page"{% endif %}>Membres</a>
        </nav>
        <div class="admin-user">
            <span>{{ app.user.userIdentifier }}</span>
            <a href="{{ logout_path() }}">Se déconnecter</a>
        </div>
    </header>

    <main class="admin-main">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash-{{ type }}" role="status">{{ message }}</p>
            {% endfor %}
        {% endfor %}
        {% block main %}{% endblock %}
    </main>
{% endblock %}
