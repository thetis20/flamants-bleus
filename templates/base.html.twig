<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Les Flamants Bleus — troupe d'improvisation théâtrale{% endblock %}</title>
        <meta name="description" content="{% block description %}Les Flamants Bleus, troupe amateure d'improvisation théâtrale : prochains spectacles, formats et réservations.{% endblock %}">
        {% block robots %}{% endblock %}
        <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
        <link rel="preload" href="{{ asset('fonts/league-spartan-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/lato-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        {% if app.current_route %}
            {% set canonical = url(app.current_route, app.current_route_parameters) %}
            <link rel="canonical" href="{{ canonical }}">
            <meta property="og:url" content="{{ canonical }}">
        {% endif %}
        <meta property="og:type" content="website">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:site_name" content="Les Flamants Bleus">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('description') }}">
        <meta property="og:image" content="{{ absolute_url(asset('images/logo.png')) }}">
        <meta name="twitter:card" content="summary">
        {% block structured_data %}{% endblock %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body class="{% block body_class %}public{% endblock %}">
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        {% block body %}
            <header class="site-header">
                <a href="{{ path('home') }}" class="brand">
                    <img src="{{ asset('images/logo.webp') }}" alt="Les Flamants Bleus" width="240" height="208" fetchpriority="high">
                </a>
                {% if instagram_url or facebook_url %}
                    <ul class="socials" aria-label="Nos réseaux sociaux">
                        {% if instagram_url %}
                            <li><a href="{{ instagram_url }}" rel="noopener" target="_blank">{{ include('_icon_instagram.svg.twig') }}<span class="social-label">cieflamantsbleus</span><span class="sr-only"> (nouvel onglet)</span></a></li>
                        {% endif %}
                        {% if facebook_url %}
                            <li><a href="{{ facebook_url }}" rel="noopener" target="_blank">{{ include('_icon_facebook.svg.twig') }}<span class="social-label">Les Flamants Bleus</span><span class="sr-only"> (nouvel onglet)</span></a></li>
                        {% endif %}
                    </ul>
                {% endif %}
            </header>

            <main class="site-main" id="contenu" tabindex="-1">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <p class="flash flash-{{ type }}" role="status">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
                {% block main %}{% endblock %}
            </main>

            <footer class="site-footer">
                <p class="small">La troupe amateure d'improvisation théâtrale · <a href="{{ path('login') }}">Espace membres</a></p>
            </footer>
        {% endblock %}
    </body>
</html>
