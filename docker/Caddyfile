{
	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
	auto_https off
	admin off
}

{$SERVER_NAME} {
	root * /app/public
	encode zstd gzip

	# AssetMapper puts a content hash in every file name.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@icons path /favicon.ico /favicon-48.png /icon-192.png /icon-512.png /apple-touch-icon.png /site.webmanifest
	header @icons Cache-Control "public, max-age=604800"
	@manifest path /site.webmanifest
	header @manifest Content-Type "application/manifest+json"

	php_server
}
